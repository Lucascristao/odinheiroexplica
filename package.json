{
  "name": "odinheiroexplica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.video.json --pretty false",
    "preview": "vite preview",
    "remotion:studio": "remotion studio video/src/index.ts",
    "render:motion-test": "remotion render video/src/index.ts BrandMotionTest render-output/macerio-motion-test.mp4 --codec=h264 --concurrency=2",
    "render:dynamic-test": "remotion render video/src/index.ts DynamicVideo render-output/dynamic-scene-test.mp4 --codec=h264 --concurrency=2",
    "render:motion-v2": "remotion render video/src/index.ts DynamicMotionV2 render-output/macerio-motion-v2.mp4 --codec=h264 --concurrency=2",
    "render:pix-pilot": "remotion render video/src/index.ts EditorialPilot render-output/pix-med-pilot.mp4 --codec=h264 --concurrency=2",
    "still:pix-pilot": "remotion still video/src/index.ts PixPilotThumbnail render-output/pix-med-thumbnail-a.png",
    "render:daily": "remotion render video/src/index.ts DailyEditorial render-output/daily-video.mp4 --codec=h264 --concurrency=2",
    "still:daily": "remotion still video/src/index.ts DailyThumbnail render-output/daily-thumbnail.png",
    "prepare:editorial-font": "node scripts/prepare-editorial-font.mjs",
    "postinstall": "npm run prepare:editorial-font",
    "validate:editorial": "tsx scripts/validate-editorial.ts",
    "validate:layout": "tsx scripts/validate-editorial-layout.ts",
    "test:explanation": "tsx scripts/test-editorial-explanation.ts",
    "test:learning": "tsx scripts/test-editorial-learning.ts && tsx scripts/test-youtube-analytics.ts",
    "test:direction": "tsx scripts/test-editorial-direction.ts",
    "test:preflight": "tsx scripts/test-editorial-preflight.ts",
    "review:motion": "tsx scripts/review-editorial-motion.ts",
    "test:layout": "tsx scripts/test-editorial-layout.ts",
    "test:motion": "tsx scripts/test-editorial-motion.ts",
    "ode": "tsx scripts/ode.ts",
    "prepare:hyperframes": "tsx scripts/prepare-hyperframes.ts",
    "test:portable": "tsx scripts/test-portable-production.ts",
    "test:cleanup": "tsx scripts/test-production-cleanup.ts"
  },
  "dependencies": {
    "@netlify/blobs": "11.0.3",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/layout-utils": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "gsap": "3.13.0",
    "hyperframes": "0.8.139",
    "remotion": "4.0.529",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
